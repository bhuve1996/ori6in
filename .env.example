# App
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
# Public web origin for SEO (canonical, sitemap, Open Graph). Use https://your-domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Soft launch: true = public sees Coming Soon only (all other routes redirect)
NEXT_PUBLIC_COMING_SOON=false
# Optional build stamp (defaults to git SHA / build time). Changing it clears
# visitor soft-launch cookies + client storage on next visit after deploy.
# NEXT_PUBLIC_DEPLOY_ID=
# Show on-page toggle (default: on in development only)
# NEXT_PUBLIC_COMING_SOON_TOGGLE=true
# Bypass / force: ?comingSoon=0 | ?comingSoon=1 | ?comingSoon=clear
# Coming-soon notify — Zoho only (no Resend / FormSubmit)
COMING_SOON_NOTIFY_TO=enquiry@ori6ineducation.com
NOTIFY_FROM_EMAIL=ORI6IN <enquiry@ori6ineducation.com>

# Zoho SMTP — works locally; Railway Hobby blocks outbound 465/587
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=enquiry@ori6ineducation.com
SMTP_PASS=your-zoho-app-password

# Zoho Mail REST API (HTTPS) — required on Railway Hobby so notify works in prod.
# India DC: accounts.zoho.in + mail.zoho.in. Set ZOHO_DC=com|eu|com.au if needed.
# 1) Create a self-client at https://api-console.zoho.in/ (Server-based)
# 2) Scope: ZohoMail.messages.CREATE,ZohoMail.accounts.READ
# 3) Generate refresh token; Account ID is in Zoho Mail → Settings → Mail Accounts
#    or GET https://mail.zoho.in/api/accounts with the access token.
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
# Set the same SMTP_* / ZOHO_* / NOTIFY_* on both web and API services.

# Database driver: postgres | mongo
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://ori6in:ori6in@localhost:5432/ori6in
MONGO_URL=mongodb://localhost:27017/ori6in

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Temporary walkthrough accounts — see docs/demo-logins.md. Set false to disable.
ENABLE_DEMO_LOGINS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage
S3_ENDPOINT=
S3_BUCKET=ori6in
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payments
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# AI
OPENAI_API_KEY=
