# App
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
# Public web origin for SEO (canonical, sitemap, Open Graph). Use https://your-domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Soft launch: true = public sees Coming Soon only (all other routes redirect)
NEXT_PUBLIC_COMING_SOON=false
# Show on-page toggle (default: on in development only)
# NEXT_PUBLIC_COMING_SOON_TOGGLE=true
# Bypass / force: ?comingSoon=0 | ?comingSoon=1 | ?comingSoon=clear
# Coming-soon notify emails (Zoho Mail SMTP — India DC)
COMING_SOON_NOTIFY_TO=rishi@ori6ineducation.com
NOTIFY_FROM_EMAIL=ORI6IN <rishi@ori6ineducation.com>
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=rishi@ori6ineducation.com
SMTP_PASS=
# If your Zoho account is on .com instead of .in, use smtp.zoho.com
# Optional alternative: RESEND_API_KEY=

# Database driver: postgres | mongo
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://ori6in:ori6in@localhost:5432/ori6in
MONGO_URL=mongodb://localhost:27017/ori6in

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Temporary walkthrough accounts — see docs/demo-logins.md. Set false to disable.
ENABLE_DEMO_LOGINS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage
S3_ENDPOINT=
S3_BUCKET=ori6in
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payments
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# AI
OPENAI_API_KEY=
